    "@types/react-dom": "^19",
    "@types/web-push": "3.6.4",
    "dotenv": "18.0.8",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
