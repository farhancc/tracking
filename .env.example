# Copy to .env.local for development. Never commit real values.

# --- Database (Neon) ----------------------------------------------------------
# Runtime: Neon POOLED endpoint, as a login role that is a member of fyos_app.
DATABASE_URL=postgres://fyos_app_login:<password>@<project>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
# Auth module only: POOLED endpoint, login role that is a member of fyos_auth.
AUTH_DATABASE_URL=postgres://fyos_auth_login:<password>@<project>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
# Migrations only (CI / your machine): DIRECT endpoint, owner role.
MIGRATION_DATABASE_URL=postgres://neondb_owner:<password>@<project>.<region>.aws.neon.tech/neondb?sslmode=require

# --- Access tokens (ES256) ------------------------------------------------------
# Generate with: npm run auth:keygen
AUTH_JWT_PRIVATE_JWK=
AUTH_JWT_PUBLIC_JWKS=
AUTH_JWT_ISSUER=fiveyearos
AUTH_JWT_AUDIENCE=fiveyearos-app

# --- Development only -----------------------------------------------------------
# Enables the "Continue as dev owner" button under `next dev`. Ignored in production builds.
FYOS_DEV_LOGIN=1
FYOS_DEV_EMAIL=owner@localhost

# --- Tests ---------------------------------------------------------------------
# Owner role with CREATEDB + CREATEROLE; integration tests create a throwaway database.
TEST_ADMIN_DATABASE_URL=postgres://fyos_owner:dev-owner@127.0.0.1:5432/postgres

# --- File storage (audio recordings) ---------------------------------------------
# "local" (development only, files under .data/uploads) or "s3" (Cloudflare R2, AWS S3, MinIO).
STORAGE_DRIVER=local
# STORAGE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_S3_REGION=auto
# STORAGE_S3_BUCKET=fiveyearos-private
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
